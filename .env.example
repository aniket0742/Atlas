

ATLAS_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

ATLAS_LLM_PROVIDER=gemini


GEMINI_API_KEY=

ATLAS_LLM_MODEL=gemini-2.5-flash

# Hard ceiling on a single generation call, in seconds.
ATLAS_LLM_TIMEOUT_SECONDS=60

# --- Embeddings (local, no API key needed) --------------------------------
ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches downloaded ONNX weights.
ATLAS_MODEL_CACHE_DIR=.models

# --- Retrieval ------------------------------------------------------------
ATLAS_RETRIEVAL_TOP_K=8
ATLAS_MIN_SIMILARITY=0.30

# --- Chunking -------------------------------------------------------------
ATLAS_CHUNK_TARGET_TOKENS=320
ATLAS_CHUNK_OVERLAP_TOKENS=64

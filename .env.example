

ATLAS_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

ATLAS_LLM_PROVIDER=gemini


GEMINI_API_KEY=

ATLAS_LLM_MODEL=gemini-2.5-flash

# Hard ceiling on a single generation call, in seconds.
ATLAS_LLM_TIMEOUT_SECONDS=60

# --- Embeddings (local, no API key needed) --------------------------------
ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches downloaded ONNX weights.
ATLAS_MODEL_CACHE_DIR=.models

# --- Retrieval ------------------------------------------------------------
# dense | lexical | hybrid. Hybrid was measured (E5) and showed no improvement
# over dense on the evaluation set, so dense is the default. See ADR-0018.
ATLAS_RETRIEVAL_MODE=dense
ATLAS_RETRIEVAL_TOP_K=8
# How deep each retrieval component goes before fusion or reranking.
ATLAS_RETRIEVAL_CANDIDATES=30

# --- Reranking ------------------------------------------------------------
# Cross-encoder reranking. Measured at nDCG@8 +0.044 over the dense baseline
# (paired 95% CI [+0.009, +0.081]) for roughly +680ms per query on CPU.
# Set false for ~77ms retrieval at lower answer quality.
ATLAS_RERANK_ENABLED=true
ATLAS_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ATLAS_RERANK_CANDIDATES=30
ATLAS_MIN_SIMILARITY=0.30

# --- Chunking -------------------------------------------------------------
ATLAS_CHUNK_TARGET_TOKENS=320
ATLAS_CHUNK_OVERLAP_TOKENS=64

# Copy to .env and fill in. .env is gitignored.

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml defaults.
ATLAS_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# --- LLM provider ---------------------------------------------------------
# "gemini" (default) or "fake" (deterministic, offline, used by tests).
ATLAS_LLM_PROVIDER=gemini

# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to call. Free-tier model availability changes over time, so this
# is deliberately not hard-coded in the source. Run `atlas models` with your key
# set to list the models your key can actually reach, then set this.
ATLAS_LLM_MODEL=gemini-2.5-flash

# Hard ceiling on a single generation call, in seconds.
ATLAS_LLM_TIMEOUT_SECONDS=60

# --- Embeddings (local, no API key needed) --------------------------------
ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where fastembed caches downloaded ONNX weights.
ATLAS_MODEL_CACHE_DIR=.models

# --- Retrieval ------------------------------------------------------------
ATLAS_RETRIEVAL_TOP_K=8
# Cosine similarity below which a chunk is not considered evidence at all.
# Tuned against the eval set, not guessed -- see docs/evaluation.md.
ATLAS_MIN_SIMILARITY=0.30

# --- Chunking -------------------------------------------------------------
ATLAS_CHUNK_TARGET_TOKENS=320
ATLAS_CHUNK_OVERLAP_TOKENS=64
